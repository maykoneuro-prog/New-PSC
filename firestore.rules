rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Basic Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // Identity Helpers
    function isUser(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Role Helpers
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'maykon.euro@gmail.com' ||
        request.auth.token.email == 'administrador@sgepsicologia.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role in ['admin', 'super-admin'])
      );
    }
    
    function isOwner(resourceData) {
      return isSignedIn() && (
        resourceData.ownerId == request.auth.uid || 
        resourceData.ownerId == request.auth.token.email
      );
    }

    function isUnitMember(resourceData) {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         resourceData.unit in getUserData().units)
      );
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Rules for Schools
    match /schools/{schoolId} {
      allow read: if true; // Public access for scheduling and portal
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isOwner(resource.data);
    }
    
    // Rules for Categories and Appointment Types
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /appointment_types/{id} { allow read: if true; allow write: if isAdmin(); }

    // Rules for Scheduling Requests (Public Submission)
    match /scheduling_requests/{id} {
      allow create: if true; // Anyone can request
      allow read, update, delete: if isSignedIn();
    }
    
    // Rules for Anonymous Reports
    match /anonymous_reports/{reportId} {
      allow create: if true; 
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Rules for Students
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Rules for Users
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow write: if isUser(userId) || isAdmin();
    }

    // Rules for Appointments
    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /plans/{id} { allow read: if true; allow write: if isAdmin(); }
    match /app_settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /documents/{id} { allow read, write: if isSignedIn(); }
    match /subscriptions/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /letterheads/{id} { allow read: if true; allow write: if isSignedIn(); }
  }
}
